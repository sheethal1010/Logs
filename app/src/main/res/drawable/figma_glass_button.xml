<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#30000000">
    <item>
        <layer-list>
            <!-- Outer subtle shadow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#15000000" />
                    <corners android:radius="40dp" />
                </shape>
            </item>

            <!-- Main glass background -->
            <item
                android:top="1dp"
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#B3FFFFFF" />
                    <corners android:radius="39dp" />
                </shape>
            </item>

            <!-- Top shine -->
            <item
                android:top="1dp"
                android:bottom="35dp"
                android:left="1dp"
                android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#55FFFFFF"
                        android:centerColor="#30FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear" />
                    <corners android:radius="39dp" />
                </shape>
            </item>

            <!-- Border -->
            <item
                android:top="1dp"
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1.5dp"
                        android:color="#80FFFFFF" />
                    <corners android:radius="39dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>