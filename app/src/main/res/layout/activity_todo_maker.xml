<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <!-- Folder Dropdown -->
        <LinearLayout
            android:id="@+id/folderDropdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_folder"
                app:tint="#9B9B9B"
                android:layout_marginEnd="8dp"
                android:contentDescription="Folder" />

            <TextView
                android:id="@+id/folderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Folder"
                android:textSize="14sp"
                android:textColor="#9B9B9B"
                android:fontFamily="@font/inter_regular" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_arrow"
                app:tint="#9B9B9B"
                android:layout_marginStart="4dp"
                android:rotation="90"
                android:contentDescription="Dropdown" />

        </LinearLayout>

        <!-- Undo Icon -->
        <ImageView
            android:id="@+id/undoIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_undo"
            app:tint="#000000"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Undo" />

        <!-- Redo Icon -->
        <ImageView
            android:id="@+id/redoIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_redo"
            app:tint="#000000"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Redo" />

        <!-- Pin Icon -->
        <ImageView
            android:id="@+id/pinIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_pin"
            app:tint="#000000"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Pin" />

        <!-- Menu Icon -->
        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu"
            app:tint="#000000"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu" />

    </LinearLayout>

    <!-- Folder Title -->
    <EditText
        android:id="@+id/folderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topToolbar"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="Folder 1"
        android:textSize="24sp"
        android:textColor="#000000"
        android:fontFamily="@font/inter_extrabold"
        android:background="@null"
        android:hint="Folder name"
        android:inputType="text"
        android:maxLines="1" />

    <!-- Todo Items List -->
    <ScrollView
        android:id="@+id/todosScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/folderTitle"
        android:layout_above="@id/bottomBar"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/todosContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Todo items will be added programmatically -->

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:background="#FFFFFF">

        <!-- Add Todo Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/addTodoInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Add a new item..."
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@color/text_grey"
                android:fontFamily="@font/inter_regular"
                android:background="@null"
                android:padding="8dp"
                android:inputType="text"
                android:imeOptions="actionDone" />

            <TextView
                android:id="@+id/addTodoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADD"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:fontFamily="@font/inter_semibold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/ripple_effect" />

        </LinearLayout>

        <!-- Date and Word Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/dateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="8th January, 2026"
                android:textSize="12sp"
                android:textColor="#9B9B9B"
                android:fontFamily="@font/inter_regular" />

            <TextView
                android:id="@+id/wordCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Words: 67"
                android:textSize="12sp"
                android:textColor="#9B9B9B"
                android:fontFamily="@font/inter_regular" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Delete Button -->
            <FrameLayout
                android:id="@+id/deleteButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/delete_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_delete"
                    app:tint="#000000"
                    android:layout_gravity="center"
                    android:contentDescription="Delete" />

            </FrameLayout>

            <!-- Share Button -->
            <TextView
                android:id="@+id/shareButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="SHARE"
                android:textSize="16sp"
                android:textColor="#000000"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:background="@drawable/share_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="16dp" />

            <!-- Save Button -->
            <TextView
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="SAVE"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:background="@drawable/save_button_bg"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>